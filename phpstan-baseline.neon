parameters:
	ignoreErrors:
		-
			message: '#^Parameter &\$variables by\-ref type of method Drupal\\vvjc\\Hook\\VvjcPreprocessHooks\:\:preprocessViewsViewVvjc\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/Hook/VvjcPreprocessHooks.php

		-
			message: '#^Method Drupal\\vvjc\\Hook\\VvjcTokenHooks\:\:tokens\(\) should return array\<string, Drupal\\Core\\Render\\Markup\|string\> but returns array\<string, Drupal\\Component\\Render\\MarkupInterface\|string\>\.$#'
			identifier: return.type
			count: 1
			path: src/Hook/VvjcTokenHooks.php
