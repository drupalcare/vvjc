{#
/**
 * @file
 * Default theme implementation for Views to output a 3D Carousel.
 *
 * Available variables:
 * - options: View plugin style options.
 *   - max_width: Maximum width of the carousel.
 *   - time_in_seconds: Time for each slide.
 *   - large_screen_height: Height of the carousel for large screens.
 *   - small_screen_height: Height of the carousel for small screens.
 *   - available_breakpoints: Breakpoints for the carousel.
 *   - perspective: Perspective value for the carousel.
 * - rows: The view result rows to be rendered.
 * - unique_id: A unique identifier for the view instance.
 *
 * @see template_preprocess_views_view_3d_carousel()
 *
 * @ingroup themeable
 */
#}

{# Define breakpoints and attach the corresponding library #}
{% set pb_breakpoints = 'vvjc/' ~ options.available_breakpoints %}
{{ attach_library(pb_breakpoints) }}

{# Set unique IDs for the carousel and container #}
{% set unique_id = options.unique_id %}
{% set main_id = 'vvjc-' ~ unique_id %}
{% set carousel_id = 'vvjc-items-' ~ unique_id %}
{% set co_id = 'co-' ~ unique_id %}

{# Set the classes for the view #}
{% set classes = [
  'vvjc',
  main_id,
  'car__large-height-' ~ options.large_screen_height,
  'car__small-height-' ~ options.small_screen_height,
] %}
{% set classes_inner = 'vvjc__inner ' ~ options.max_width %}

<div {{ attributes.addClass(classes).setAttribute('id', main_id) }} role="region" aria-label="Image Carousel">
  <div class="{{ classes_inner }}"{% if options.perspective %} style="perspective:{{ options.perspective }}px"{% endif %}>
    <div id="{{ carousel_id }}" class="vvjc-items" role="group" aria-roledescription="carousel" aria-labelledby="index-{{ unique_id }}">
      {% for row in rows %}
        {% set row_id = 'item-' ~ unique_id ~ '-' ~ loop.index %}
        <div id="{{ row_id }}" class="view__3d-item item-{{ unique_id }}-{{ loop.index }}" role="tabpanel" aria-hidden="{{ loop.first ? 'false' : 'true' }}" tabindex="{{ loop.first ? '0' : '-1' }}" aria-labelledby="label-{{ row_id }}">
          <div id="label-{{ row_id }}" class="visually-hidden">Slide {{ loop.index }} of {{ rows|length }}</div>
          {{ row.content }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div id="{{ co_id }}" class="views--3d-carousel-nav" aria-label="Carousel Controls">
    <div class="pb__row">
      <button id="prev-{{ unique_id }}" role="button" class="car__button car__prev" aria-controls="{{ carousel_id }}" aria-label="Previous Slide">
        <span class="visually-hidden">{{ 'Previous Slide'|t }}</span>&#10094;
      </button>
      <span id="index-{{ unique_id }}" class="car__slide-number" aria-label="{{ 'Slide 1 of @count'|t({'@count': rows|length}) }}" aria-live="polite"></span>
      {% if options.time_in_seconds > 0 %}
        <button id="btn-{{ unique_id }}" class="car__button hide-{{ options.time_in_seconds }} car_play" aria-controls="{{ carousel_id }}" aria-label="Play Slideshow">
          <span class="visually-hidden">{{ 'Play Pause Slideshow'|t }}</span>&#10073;&nbsp;&#10073;
        </button>
      {% endif %}
      <button id="next-{{ unique_id }}" role="button" class="car__button car__next" aria-controls="{{ carousel_id }}" aria-label="Next Slide">
        <span class="visually-hidden">{{ 'Next Slide'|t }}</span>&#10095;
      </button>
    </div>

    <div class="time__in-seconds" aria-hidden="true">
      {{ options.time_in_seconds }}
    </div>
  </div>
</div>
