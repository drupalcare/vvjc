{#
/**
 * @file
 * Default theme implementation for Views to output a 3D Carousel.
 *
 * Available variables:
 * - options: View plugin style options.
 *   - max_width: Maximum width of the carousel.
 *   - time_in_seconds: Time for each slide.
 *   - large_screen_height: Height of the carousel for large screens.
 *   - small_screen_height: Height of the carousel for small screens.
 *   - available_breakpoints: Breakpoints for the carousel.
 *   - perspective: Perspective value for the carousel.
 * - rows: The view result rows to be rendered.
 * - unique_id: A unique identifier for the view instance.
 *
 * @see template_preprocess_views_view_3d_carousel()
 *
 * @ingroup themeable
 */
#}

{# Set unique IDs for the carousel and container #}
{% set unique_id = options.unique_id %}
{% set time_in_seconds = options.time_in_seconds %}
{% set vvjc_id = 'vvjc-' ~ unique_id %}
{% set carousel_id = 'vvjc-items-' ~ unique_id %}
{% set bottom_nav_id = 'vvjc-nav-' ~ unique_id %}

{# Set the classes for the view #}
{% set classes = [
  'vvjc',
  vvjc_id,
  'height-large-' ~ options.large_screen_height,
  'height-small-' ~ options.small_screen_height,
] %}
{% set classes_inner = 'vvjc-inner ' ~ 'max-width-' ~ options.max_width %}

<div {{ attributes.addClass(classes).setAttribute('id', vvjc_id) }} role="region" aria-label="{{ 'Image Carousel'|t }}">
  <div class="{{ classes_inner }}"{% if options.perspective %} style="perspective:{{ options.perspective }}px"{% endif %}>
    <div id="{{ carousel_id }}" class="vvjc-items" role="region" aria-roledescription="carousel" aria-labelledby="index-{{ unique_id }}">
      {% for row in rows %}
        {% set row_id = 'item-' ~ unique_id ~ '-' ~ loop.index %}
        <div id="{{ row_id }}" class="vvjc-item item-{{ unique_id }}-{{ loop.index }}" role="tabpanel" aria-hidden="{{ loop.first ? 'false' : 'true' }}" tabindex="{{ loop.first ? '0' : '-1' }}" aria-labelledby="label-{{ row_id }}" {% if background_rgb and not options.disable_background %} style="background-color:{{ background_rgb }}"{% endif %}>
          <div id="label-{{ row_id }}" class="visually-hidden">{{ 'Slide @index of @count'|t({'@index': loop.index, '@count': rows|length}) }}</div>
          {{ row.content }}
        </div>
      {% endfor %}
    </div>
  </div>

  <div id="{{ bottom_nav_id }}" class="vvjc-nav" data-time="{{ time_in_seconds }}" aria-label="{{ 'Carousel Controls'|t }}">
    <div class="vvjc-nav-inner">
      {% if time_in_seconds > 0 %}
        <button id="btn-{{ unique_id }}" class="button display-{{ time_in_seconds }} play" aria-controls="{{ carousel_id }}" aria-label="{{ 'Play Slideshow'|t }}">
          <span class="visually-hidden">{{ 'Play Pause 3D Carousel'|t }}</span>
            <svg class="svg-pause" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="inherit"><path d="M360-320h80v-320h-80v320Zm160 0h80v-320h-80v320ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
        </button>
      {% endif %}
      <button id="prev-{{ unique_id }}" role="button" class="button prev-arrow" aria-controls="{{ carousel_id }}" aria-label="{{ 'Previous Slide'|t }}">
        <span class="visually-hidden">{{ 'Previous Slide'|t }}</span><svg class="svg-prev" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="inherit"><path d="m480-320 56-56-64-64h168v-80H472l64-64-56-56-160 160 160 160Zm0 240q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
      </button>
      <span id="index-{{ unique_id }}" class="current-slide-number" aria-live="polite" aria-label="{{ 'Slide @index of @count'|t({'@index': 1, '@count': rows|length}) }}"></span>

      <button id="next-{{ unique_id }}" role="button" class="button next-arrow" aria-controls="{{ carousel_id }}" aria-label="{{ 'Next Slide'|t }}">
        <span class="visually-hidden">{{ 'Next Slide'|t }}</span></span><svg class="svg-next" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="inherit"><path d="m480-320 160-160-160-160-56 56 64 64H320v80h168l-64 64 56 56Zm0 240q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
      </button>
    </div>

  </div>
</div>
