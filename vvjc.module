use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_help().
 */
function vvjc_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.vvjc') {
    return _vvjc_helper_render_readme();
  }
  return NULL;
}

/**
 * Helper function to render README.md.
 */
function _vvjc_helper_render_readme() {
  $text = file_get_contents(__DIR__ . "/README.md");

  if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
    return '<pre>' . $text . '</pre>';
  }

  // Use the Markdown filter to render the README.
  $filter_manager = \Drupal::service('plugin.manager.filter');
  $settings = \Drupal::configFactory()
    ->get('markdown.settings')
    ->getRawData();
  $config = ['settings' => $settings];
  $filter = $filter_manager->createInstance('markdown', $config);
  return $filter->process($text, 'en');
}

/**
 * Implements hook_theme().
 */
function vvjc_theme($existing, $type, $theme, $path) {
  return [
    'views_view_vvjc' => [
      'variables' => [
        'view' => NULL,
        'rows' => [],
        'options' => [],
      ],
      'template' => 'views-view-vvjc',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for views_view_vvjc.
 */
function template_preprocess_views_view_vvjc(&$variables) {
  \Drupal::moduleHandler()->loadInclude('views', 'inc', 'views.theme');
  $handler = $variables['view']->style_plugin;

  // Define list attributes if needed.
  $list_attributes = [];

  $variables['list_attributes'] = new \Drupal\Core\Template\Attribute($list_attributes);

  $variables['settings'] = [
    'time_in_seconds' => $handler->options['time_in_seconds'],
    'max_width' => $handler->options['max_width'],
    'large_screen_height' => $handler->options['large_screen_height'],
    'small_screen_height' => $handler->options['small_screen_height'],
    'available_breakpoints' => $handler->options['available_breakpoints'],
    'perspective' => $handler->options['perspective'],
    'unique_id' => $handler->options['unique_id'],
  ];

  // Ensure unformatted preprocess function is called.
  template_preprocess_views_view_unformatted($variables);
}

